# Copy this file to .env and fill in real values -- .env is gitignored.

# MySQL connection string (Prisma format). Any managed MySQL works:
# PlanetScale, Railway, Aiven, or a local MySQL instance.
# Example: mysql://user:password@host:3306/database_name
DATABASE_URL="mysql://user:password@localhost:3306/signal_blog"

# Any long random string -- used to sign login session tokens.
# Generate one with: openssl rand -base64 32
JWT_SECRET="replace-this-with-a-long-random-string"

# The site's public URL -- used for canonical links, Open Graph/Twitter
# tags, and sitemap.xml/robots.txt. Set this to your real domain in
# production (e.g. on Vercel: https://your-project.vercel.app or a
# custom domain). Falls back to localhost:3000 if unset, which is fine
# for local development.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
